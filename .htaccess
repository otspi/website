# ==============================================================================
# Open eIDAS — Configuration Apache / Infomaniak (.htaccess)
# Le projet Open eIDAS est devenu OTSPI : open-eidas.eu redirige de façon
# permanente vers www.otspi.org et about.otspi.org.
# Les sous-domaines (demo, api.staging) ne sont pas servis par ce répertoire.
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validation des certificats Let's Encrypt : jamais redirigée
  RewriteRule ^\.well-known/ - [L]

  # Correspondance page par page
  RewriteRule ^association\.html$ https://about.otspi.org/ [R=301,L]
  RewriteRule ^mentions-legales\.html$ https://www.otspi.org/mentions-legales.html [R=301,L]
  RewriteRule ^donnees-personnelles\.html$ https://www.otspi.org/mentions-legales.html [R=301,L]
  RewriteRule ^eidas\.html$ https://www.otspi.org/#constat [R=301,L,NE]

  # Toute autre adresse, y compris l'accueil
  RewriteRule ^ https://www.otspi.org/ [R=301,L]
</IfModule>

# En-têtes de sécurité (conservés pour les réponses de redirection)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
